#!/bin/sh
set -e
# Create the service user and directories declaratively, then enable the unit.
if command -v systemd-sysusers >/dev/null 2>&1; then
    systemd-sysusers tornas.conf || true
else
    id tornas >/dev/null 2>&1 || useradd --system --home /var/lib/tornas --shell /usr/sbin/nologin tornas
fi
if command -v systemd-tmpfiles >/dev/null 2>&1; then
    systemd-tmpfiles --create tornas.conf || true
else
    mkdir -p /var/lib/tornas /etc/tornas && chown tornas:tornas /var/lib/tornas
fi
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
    if [ "$1" = "configure" ] && [ -z "$2" ]; then
        systemctl enable tornas.service || true
        echo "tornas installed. Edit /etc/tornas/tornas.env (TORNAS_DISK_BUDGET, TORNAS_TMDB_TOKEN), then: systemctl start tornas"
    else
        # upgrade: restart if it was running
        if systemctl is-active --quiet tornas.service; then
            systemctl restart tornas.service || true
        fi
    fi
fi
exit 0
