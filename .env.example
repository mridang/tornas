# Copy to .env (gitignored) and fill in. The systemd unit reads the same variables.
TORNAS_DATA_DIR=/var/lib/tornas
TORNAS_DISK_BUDGET=800G
TORNAS_MIN_FREE=20G
TORNAS_HTTP_LISTEN=0.0.0.0:3030
# Address browsers/TVs can reach; used in Stremio stream links. Defaults to the request Host header.
#TORNAS_PUBLIC_URL=http://192.168.1.10:3030
# TMDB v4 read access token (preferred) or v3 API key.
TORNAS_TMDB_TOKEN=
#TORNAS_TMDB_API_KEY=
TORNAS_DLNA_NAME=Tornas
#TORNAS_STREAM_GRACE=15m
#TORNAS_TLS_CERT=/etc/tornas/cert.pem
#TORNAS_TLS_KEY=/etc/tornas/key.pem
#RQBIT_LISTEN_PORT=4240
# API write protection and unattended updates
#TORNAS_API_TOKEN=change-me
#TORNAS_AUTO_UPDATE=24h
#TORNAS_STALL_TIMEOUT=6h
#TORNAS_LOG_FORMAT=json
#TORNAS_LOG_DIR=/var/lib/tornas/logs
