{#- systemd EnvironmentFile. Values are double-quoted; booleans must be exactly
    "true" or "false", which is all the server accepts. -#}
{%- macro kv(k, v) -%}
{%- if v is boolean -%}
{{ k }}={{ v | lower }}
{%- else -%}
{{ k }}="{{ v | string | replace('\\', '\\\\') | replace('"', '\\"') }}"
{%- endif -%}
{%- endmacro -%}
# Managed by Ansible ({{ role_name | default('tornas') }} role). Local edits are overwritten.
# Validate by hand with: tornas config check --env /etc/tornas/tornas.env
{{ kv('TORNAS_DISK_BUDGET', tornas_disk_budget) }}
{{ kv('TORNAS_MIN_FREE', tornas_min_free) }}
{{ kv('TORNAS_HTTP_LISTEN', tornas_http_listen) }}
{{ kv('TORNAS_MDNS_NAME', tornas_mdns_name) }}
{{ kv('TORNAS_STREAM_GRACE', tornas_stream_grace) }}
{{ kv('TORNAS_STALL_TIMEOUT', tornas_stall_timeout) }}
{{ kv('TORNAS_PAUSE_DURATION', tornas_pause_duration) }}
{{ kv('TORNAS_LOG_FORMAT', tornas_log_format) }}
{{ kv('TORNAS_REQUIRE_MOUNT', tornas_require_mount | bool) }}
{{ kv('TORNAS_KEEP_SEEDING', tornas_keep_seeding | bool) }}
{{ kv('TORNAS_DLNA_DISABLE', tornas_disable_dlna | bool) }}
{% if tornas_tmdb_token %}{{ kv('TORNAS_TMDB_TOKEN', tornas_tmdb_token) }}
{% endif %}
{% if tornas_api_token %}{{ kv('TORNAS_API_TOKEN', tornas_api_token) }}
{% endif %}
{% if tornas_public_url %}{{ kv('TORNAS_PUBLIC_URL', tornas_public_url) }}
{% endif %}
{% if tornas_dlna_name %}{{ kv('TORNAS_DLNA_NAME', tornas_dlna_name) }}
{% endif %}
{% if tornas_auto_update %}{{ kv('TORNAS_AUTO_UPDATE', tornas_auto_update) }}
{% endif %}
{% if tornas_log_dir %}{{ kv('TORNAS_LOG_DIR', tornas_log_dir) }}
{% endif %}
{% if tornas_ratelimit_download | string %}{{ kv('TORNAS_RATELIMIT_DOWNLOAD', tornas_ratelimit_download) }}
{% endif %}
{% if tornas_ratelimit_upload | string %}{{ kv('TORNAS_RATELIMIT_UPLOAD', tornas_ratelimit_upload) }}
{% endif %}
{% if tornas_listen_port | string %}{{ kv('RQBIT_LISTEN_PORT', tornas_listen_port) }}
{% endif %}
{% for k, v in tornas_extra_env | dictsort %}{{ kv(k, v) }}
{% endfor %}
